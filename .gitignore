# Environment variables
.env*.local

# Common ignores
node_modules
.next/
out/
.DS_Store

# Editor / agent local config
.claude/

# AI agent scratch state: brainstorm dev-servers, PID files, plan/progress
# journals. These were tracked historically; the files are removed on this
# branch. If you still have local copies, untrack them with:
#   git rm -r --cached .superpowers .tocodex tocodex-docs
.superpowers/
.tocodex/
tocodex-docs/

# Build + analysis output (bundle stats, generated exports, scratch renders)
artifacts/
output/

# Marketing site file-backed storage (subscribers / feedback)
.data/

# TypeScript incremental build info
tsconfig.tsbuildinfo

# Alternate package-manager lockfile (this project uses npm; package-lock.json is the source of truth)
pnpm-lock.yaml
yarn.lock

# Dev server & test logs (any file ending in .log at the repo root or under artifacts/)
*.log
artifacts/*.log
artifacts/dev-server-*.out.log
artifacts/dev-server-*.err.log
artifacts/webpack-stats.json

# Local codex dev-process artifacts (PIDs, captured stdout/stderr)
.codex-*.pid
.codex-*.out
.codex-*.err

# Playwright test artifacts
test-results/
playwright-report/
coverage/

# GSAP external resources
gsap-public/
gsap-skills-main/

# Agent guidelines and temp local images
SKILL.md

# Dated security audit drafts (committed audit reports — e.g. vulnerabilities_report.txt
# — should be added explicitly with `git add -f` if you want them tracked)
security_audit_*.txt
